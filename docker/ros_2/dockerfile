
FROM osrf/ros:humble-simulation

SHELL ["/bin/bash", "-c"]

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    ros-humble-ros-gz-sim \
    ros-humble-ros-gz-bridge \
    ros-humble-ros-gz-interfaces \
    ros-humble-xacro \
    ros-humble-ros2-control \
    ros-humble-ros2-controllers \
    ros-humble-gazebo-ros2-control \
    ros-humble-joint-state-publisher-gui \
    ros-humble-urdf-tutorial \
    ros-humble-ign-ros2-control \
    ros-humble-ros-core \
    ros-humble-geometry2 \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/* /var/cache/apt/*

ENV GAZEBO_PLUGIN_PATH=$GAZEBO_PLUGIN_PATH:/opt/ros/humble/lib

WORKDIR /app

COPY ros_entrypoint.sh /app/ros_entrypoint.sh
RUN chmod +x /app/ros_entrypoint.sh

ENTRYPOINT ["/app/ros_entrypoint.sh"]
CMD ["bash"]
